PORT=3000
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge
# Dev placeholders only. In production use `openssl rand -hex 32` for each: the API refuses to
# start (NODE_ENV=production) with these or anything shorter than 32 characters.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
WEB_ORIGIN=http://localhost:4200
API_PUBLIC_URL=http://localhost:3000
# Optional: from https://www.strava.com/settings/api. Strava sync is disabled without these.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Reverse proxies between clients and the API (rate limits read the client IP through them).
# 1 = the web container's nginx; 2 if another proxy sits in front of it. See README, Deploying.
TRUST_PROXY=1
