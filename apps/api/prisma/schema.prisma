generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Athlete {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  refreshTokens RefreshToken[]
  workouts      Workout[]

  @@map("athletes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  athleteId String
  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([athleteId])
  @@map("refresh_tokens")
}

enum Discipline {
  SWIM
  BIKE
  RUN
  STRENGTH
  OTHER
}

enum WorkoutSource {
  MANUAL
  IMPORT
  STRAVA
  COACH_DRAFT
}

model Workout {
  id        String  @id @default(uuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  discipline Discipline
  date       DateTime
  source     WorkoutSource @default(MANUAL)

  title String?
  notes String?

  targetDurationSec Int?
  targetDistanceM   Float?
  targetIntensity   String?

  actualDurationSec Int?
  actualDistanceM   Float?
  actualIntensity   String?

  completed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId, date])
  @@map("workouts")
}
