generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Athlete {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  /// Secret token for the read-only ICS calendar feed URL (`/calendar-feed/:token.ics`).
  /// Null until the athlete first enables sync; regenerating invalidates the old feed URL.
  calendarFeedToken String? @unique

  /// Thresholds used everywhere a %-of-threshold target/TSS is computed (program builder now;
  /// dashboard TSS/CTL/ATL and coach context in later milestones). All null until set.
  ftpWatts                 Int?
  runThresholdPaceSecPerKm Int?
  swimThresholdPaceSec100m Int?
  thresholdHr              Int?

  refreshTokens    RefreshToken[]
  workouts         Workout[]
  planImports      PlanImport[]
  workoutTemplates WorkoutTemplate[]

  @@map("athletes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  athleteId String
  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([athleteId])
  @@map("refresh_tokens")
}

enum Discipline {
  SWIM
  BIKE
  RUN
  STRENGTH
  OTHER
}

enum WorkoutSource {
  MANUAL
  IMPORT
  STRAVA
  COACH_DRAFT
}

model Workout {
  id        String  @id @default(uuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  discipline Discipline
  date       DateTime
  source     WorkoutSource @default(MANUAL)

  title String?
  notes String?

  targetDurationSec Int?
  targetDistanceM   Float?
  targetIntensity   String?

  actualDurationSec Int?
  actualDistanceM   Float?
  actualIntensity   String?

  /// Structured warm-up/interval/repeat steps, preserved from an imported plan format when it provides them.
  structuredIntervals Json?

  completed Boolean @default(false)

  planImportId String?
  planImport   PlanImport? @relation(fields: [planImportId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId, date])
  @@map("workouts")
}

enum PlanFormat {
  TRAININGPEAKS_CSV
  ICS
  FIT
  TCX
}

model PlanImport {
  id        String  @id @default(uuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  filename String
  format   PlanFormat

  createdCount Int      @default(0)
  updatedCount Int      @default(0)
  skippedCount Int      @default(0)
  warnings     String[] @default([])

  importedAt DateTime @default(now())

  workouts Workout[]

  @@index([athleteId, importedAt])
  @@map("plan_imports")
}

/// A reusable structured workout built in the program builder, saved to apply to another
/// date or repeat on a schedule. Applying one creates an ordinary `Workout` (source: MANUAL)
/// with these steps copied into `structuredIntervals` -- the template itself is never edited
/// by that Workout going forward.
model WorkoutTemplate {
  id        String  @id @default(uuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  name       String
  discipline Discipline

  /// WorkoutStep[] (see @forge/shared) -- same shape as Workout.structuredIntervals.
  steps Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId])
  @@map("workout_templates")
}
