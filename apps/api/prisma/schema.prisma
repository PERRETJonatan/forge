generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Athlete {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  /// Secret token for the read-only ICS calendar feed URL (`/calendar-feed/:token.ics`).
  /// Null until the athlete first enables sync; regenerating invalidates the old feed URL.
  calendarFeedToken String? @unique

  /// Thresholds used everywhere a %-of-threshold target/TSS is computed (program builder,
  /// dashboard TSS/CTL/ATL; coach context in a later milestone). All null until set.
  ftpWatts                 Int?
  runThresholdPaceSecPerKm Int?
  swimThresholdPaceSec100m Int?
  thresholdHr              Int?

  /// Target race for the dashboard countdown. Date-only, stored at UTC midnight like Workout.date.
  raceName String?
  raceDate DateTime?

  refreshTokens    RefreshToken[]
  workouts         Workout[]
  planImports      PlanImport[]
  workoutTemplates WorkoutTemplate[]
  stravaConnection StravaConnection?
  stravaActivities StravaActivity[]

  @@map("athletes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  athleteId String
  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([athleteId])
  @@map("refresh_tokens")
}

enum Discipline {
  SWIM
  BIKE
  RUN
  STRENGTH
  OTHER
}

enum WorkoutSource {
  MANUAL
  IMPORT
  STRAVA
  COACH_DRAFT
  /// Written by the plan generator (program builder -> Training plan). Regenerating replaces
  /// only these (future, not completed), never hand-built or imported workouts.
  GENERATED
}

model Workout {
  id        String  @id @default(uuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  discipline Discipline
  date       DateTime
  source     WorkoutSource @default(MANUAL)

  title String?
  notes String?

  targetDurationSec Int?
  targetDistanceM   Float?
  targetIntensity   String?

  actualDurationSec Int?
  actualDistanceM   Float?
  actualIntensity   String?

  /// Structured warm-up/interval/repeat steps, preserved from an imported plan format when it provides them.
  structuredIntervals Json?

  completed Boolean @default(false)

  planImportId String?
  planImport   PlanImport? @relation(fields: [planImportId], references: [id], onDelete: SetNull)

  /// Reverse side of StravaActivity.matchedWorkoutId -- present once a synced activity has
  /// been matched to (or created) this workout. No column here; StravaActivity owns the FK.
  stravaActivity StravaActivity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId, date])
  @@map("workouts")
}

enum PlanFormat {
  TRAININGPEAKS_CSV
  ICS
  FIT
  TCX
}

model PlanImport {
  id        String  @id @default(uuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  filename String
  format   PlanFormat

  createdCount Int      @default(0)
  updatedCount Int      @default(0)
  skippedCount Int      @default(0)
  warnings     String[] @default([])

  importedAt DateTime @default(now())

  workouts Workout[]

  @@index([athleteId, importedAt])
  @@map("plan_imports")
}

/// A reusable structured workout built in the program builder, saved to apply to another
/// date or repeat on a schedule. Applying one creates an ordinary `Workout` (source: MANUAL)
/// with these steps copied into `structuredIntervals` -- the template itself is never edited
/// by that Workout going forward.
model WorkoutTemplate {
  id        String  @id @default(uuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  name       String
  discipline Discipline

  /// WorkoutStep[] (see @forge/shared) -- same shape as Workout.structuredIntervals.
  steps Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId])
  @@map("workout_templates")
}

/// One athlete's Strava OAuth connection. Access/refresh tokens are stored in plaintext --
/// a v1/local-dev-only simplification (see README, "Deployment target for v1: local dev
/// only"), same spirit as this app's other local-dev shortcuts; production would encrypt
/// these at rest.
model StravaConnection {
  id        String  @id @default(uuid())
  athleteId String  @unique
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  stravaAthleteId BigInt
  accessToken     String
  refreshToken    String
  expiresAt       DateTime

  /// Null until the first sync completes; incremental syncs fetch activities after this.
  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("strava_connections")
}

/// A synced Strava activity, kept as its own row (distinct from the Workout it's matched to)
/// so an athlete can see what was matched and unmatch it without losing the source data.
/// Streams (pace/power over the activity, splits/laps) are out of scope for v1 -- only
/// summary fields, same ones the dashboard's TSS calc will need in a later milestone.
model StravaActivity {
  id        String  @id @default(uuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  stravaActivityId BigInt     @unique
  discipline       Discipline
  name             String?
  startDate        DateTime
  durationSec      Int
  distanceM        Float?
  elevationGainM   Float?
  avgWatts         Float?
  avgHr            Float?
  avgSpeedMps      Float?

  /// Set once, at first sync, if a same-date/discipline planned workout without a match was
  /// found (or a new source: STRAVA workout was created otherwise). Never re-attempted on
  /// later syncs, so an athlete's manual "unmatch" sticks.
  matchedWorkoutId String?  @unique
  matchedWorkout   Workout? @relation(fields: [matchedWorkoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId, startDate])
  @@map("strava_activities")
}
